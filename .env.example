# ==========================================================================
# Copie para .env e preencha. NÃO comite o .env.
# Alguns valores são repetidos nos .env.example de cada serviço — este aqui
# é a referência central.
# ==========================================================================

# ---- Supabase (projeto cloud — https://app.supabase.com) ----
# Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...            # "anon public"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # "service_role" — SÓ no backend, nunca no frontend
# Settings > API > JWT Settings > JWT Secret  (para validar o token no backend)
SUPABASE_JWT_SECRET=super-secret-jwt-string-from-supabase

# ---- Backend (Node/Express) ----
BACKEND_PORT=8080
# Segredo compartilhado backend <-> parser (invente uma string longa aleatória)
PARSER_SHARED_SECRET=troque-por-uma-string-aleatoria-longa
PARSER_URL=http://localhost:8100
# Origem permitida no CORS (a URL do frontend)
FRONTEND_ORIGIN=http://localhost:5173

# ---- Parser (Python/FastAPI) ----
PARSER_PORT=8100
# Mesmo valor de PARSER_SHARED_SECRET acima
PARSER_SHARED_SECRET=troque-por-uma-string-aleatoria-longa

# ---- Frontend (Vite) — ver frontend/.env.example ----
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_API_URL
