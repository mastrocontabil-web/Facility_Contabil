# Frontend (Vite) — só variáveis VITE_* chegam ao browser.
# NUNCA coloque a service_role key aqui.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL do backend. Em dev deixe vazio: o proxy do Vite manda /api pro :8080.
# Em produção, a URL pública do backend, ex: https://api.seu-dominio.com
VITE_API_URL=
